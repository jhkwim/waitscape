# server.py·개발 서버(tools/dev.ts)가 읽는 환경변수 (모두 선택. 비워 두면 기본값 사용). 시크릿 없음.
# 포트 (기본 7777). 브라우저는 http://localhost:<포트> 또는 http://127.0.0.1:<포트>로만 접속 가능(Host 검사)
WAITING_ROOM_PORT=7777
# 훅 이벤트 로그 (기본 ~/.claude/waiting-room/events.jsonl)
WAITING_ROOM_LOG=
# statusline 탭 결과 (기본 ~/.claude/waiting-room/statusline.json)
WAITING_ROOM_STATUS=
# Claude Code 트랜스크립트 폴더 (기본 ~/.claude/projects)
WAITING_ROOM_PROJECTS=
# 1이면 사용 한도를 5분마다 직접 조회 (기본 꺼짐. 토큰은 키체인에서 읽어 메모리에만 보관)
WAITING_ROOM_POLL_USAGE=0
# 사용자(외부) 모드 폴더 (기본 ~/.claude/waiting-room/modes). 폴더 이름 = 모드 id. 샌드박스에서 실행됨
WAITING_ROOM_MODES=
# 퇴근 일보 일지 폴더 (기본 ~/.claude/waiting-room/daylog, Rust는 <CLAUDE_CONFIG_DIR>/waiting-room/daylog). off면 기록하지 않음.
# 하루(새벽 4시 경계)마다 <YYYY-MM-DD>.json, 14일 뒤 삭제, 외부 전송 없음. server.py는 import만 한 테스트에서는 이 값이 있을 때만 기록
WAITING_ROOM_DAYLOG=
# MCP 보고 기록 파일 (wr-hook mcp가 쓰고 server.py·wr-server·앱이 읽음. 기본 <CLAUDE_CONFIG_DIR 또는 ~/.claude>/waiting-room/reports.jsonl — Python·Rust 같음).
# off면 읽지도 쓰지도 않음. 사이드카 등록 명령은 이 값 대신 --reports <절대 경로> 인자를 쓴다(CLI가 환경변수를 넘기지 않을 수 있음. 상대 경로는 무시). 외부 전송 없음
WAITING_ROOM_REPORTS=
# --- Rust 백엔드 (wr-server / wr-hook / 앱이 공통으로 읽음. 위 WAITING_ROOM_* 도 그대로 호환) ---
# Claude 설정 루트 (기본 ~/.claude). Claude Code의 같은 이름 변수. 로그·트랜스크립트·자격증명 기본 경로가 이 아래로 바뀜
CLAUDE_CONFIG_DIR=
# 세션 상태 출처: auto(기본, 최근 10분 훅 이벤트가 있으면 훅 아니면 트랜스크립트) | hooks(server.py와 동일) | transcript
WAITING_ROOM_SOURCE=auto
# wr-server 저장소 루트 (brand.json과 web/가 있는 폴더. 기본: 빌드한 저장소)
WAITING_ROOM_ROOT=
# 숨길 프로젝트 패턴 (쉼표 구분. 경로·폴더 이름의 일부, 대소문자 무시). 맞는 프로젝트의 세션은 보이지 않고 트랜스크립트도 읽지 않음 (server.py·wr-server)
WAITING_ROOM_HIDE=
# 0이면 알려진 플러그인 내부 세션(.claude-mem/observer-sessions) 기본 숨김을 끔 (기본 1)
WAITING_ROOM_HIDE_DEFAULTS=1
# --- CI·커밋 검사 (scripts/check_commit_emails.py) ---
# 작성자·커미터 이메일이 이 도메인이면 실패. 쉼표 구분. CI에서는 저장소 시크릿 BLOCKED_EMAIL_DOMAINS로 설정(코드·문서에 실제 값을 쓰지 않는다).
# 로컬 예시(가짜 값): BLOCKED_EMAIL_DOMAINS=example.com,example.org
BLOCKED_EMAIL_DOMAINS=
# --- 개발 서버 (bun tools/dev.ts) ---
# 개발 서버 포트 (기본 7780)
WR_DEV_PORT=7780
# 프록시할 백엔드 주소 (기본 http://127.0.0.1:7777, 127.0.0.1/localhost만 허용)
WR_BACKEND=http://127.0.0.1:7777

# --- 데스크톱 앱 (app/src-tauri) ---
# 앱은 위의 CLAUDE_CONFIG_DIR, WAITING_ROOM_LOG, WAITING_ROOM_PROJECTS, WAITING_ROOM_MODES(사용자 모드 폴더, 기본 = 앱 데이터 폴더/modes), WAITING_ROOM_DAYLOG, WAITING_ROOM_REPORTS(경로만. 켜고 끄기는 앱 설정 mcpReports, 기본 꺼짐)를 그대로 따른다.
# wr-hook mcp 진단 로그: 1이면 stderr에 짧게 남김 (stdout은 JSON-RPC 전용)
WR_MCP_DEBUG=
# MCP 보고 연결(설정 → AI 연결): Codex 설정 폴더. 비우면 ~/.codex (Codex CLI 자체의 변수를 그대로 따름 — 앱은 그 안의 config.toml만 고친다)
CODEX_HOME=
# 사용 한도 조회는 앱 설정의 동의로 켠다(WAITING_ROOM_POLL_USAGE는 wr-server/server.py용).
# 앱 안 업데이트 확인은 앱 설정(업데이트 → 새 버전 확인, 기본 켜짐)으로 끈다. 환경변수 없음.

# --- 릴리스 빌드 서명 (tauri CLI가 읽음. docs/RELEASE.md §5) ---
# 업데이터(minisign) 비밀 키·암호. CI에서는 release 환경(GitHub Environments) 시크릿으로만 넣는다(docs/RELEASE.md §5). 실제 값을 이 파일이나 저장소에 쓰지 않는다.
# 로컬에서 서명된 업데이터 산출물을 만들 때만: 셸에서 비밀 관리자 값을 넣고 --config로 createUpdaterArtifacts를 켠다.
TAURI_SIGNING_PRIVATE_KEY=<REPLACE_WITH_SECRET_MANAGER>
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=<REPLACE_WITH_SECRET_MANAGER>
# (디버그 빌드 전용) E2E 드라이버: 이 폴더의 <창>.<이름>.js를 그 창에서 실행하고 <이름>.out에 결과를 쓴다. 릴리스 빌드에는 없음
WAITSCAPE_E2E_DIR=
