{
  "_doc": "한도 병합 규칙 공통 케이스. Rust(limits::merge_limits)와 Python(statusline_tap.merge_limits, server.merge_limits)이 같은 결과를 내야 한다. expect=null은 '비어 있음'.",
  "cases": [
    {"name": "오래된 값(같은 창, 더 낮은 사용률)은 최댓값에 밀린다",
     "now": 1000,
     "prev": {"seven_day": {"used_percentage": 52, "resets_at": 5000}},
     "new":  {"seven_day": {"used_percentage": 23, "resets_at": 5000}},
     "expect": {"seven_day": {"used_percentage": 52, "resets_at": 5000}}},
    {"name": "5h 없는 보고는 기존 유효한 5h를 지우지 않는다",
     "now": 1000,
     "prev": {"five_hour": {"used_percentage": 13, "resets_at": 2000}, "seven_day": {"used_percentage": 52, "resets_at": 5000}},
     "new":  {"seven_day": {"used_percentage": 40, "resets_at": 5000}},
     "expect": {"five_hour": {"used_percentage": 13, "resets_at": 2000}, "seven_day": {"used_percentage": 52, "resets_at": 5000}}},
    {"name": "5h resets_at가 null(알 수 없음)인 보고도 같은 창으로 본다",
     "now": 1000,
     "prev": {"five_hour": {"used_percentage": 13, "resets_at": 2000}},
     "new":  {"five_hour": {"used_percentage": 20, "resets_at": null}},
     "expect": {"five_hour": {"used_percentage": 20, "resets_at": 2000}}},
    {"name": "사용률이 오르면 올라간 값을 쓴다",
     "now": 1000,
     "prev": {"five_hour": {"used_percentage": 13, "resets_at": 2000}},
     "new":  {"five_hour": {"used_percentage": 18, "resets_at": 2000}},
     "expect": {"five_hour": {"used_percentage": 18, "resets_at": 2000}}},
    {"name": "새 창(더 늦은 resets_at)은 낮은 사용률이어도 이전 창을 대체",
     "now": 1000,
     "prev": {"five_hour": {"used_percentage": 90, "resets_at": 2000}},
     "new":  {"five_hour": {"used_percentage": 2, "resets_at": 20000}},
     "expect": {"five_hour": {"used_percentage": 2, "resets_at": 20000}}},
    {"name": "오래된 세션이 보낸 이전 창은 새 창을 대체하지 못한다",
     "now": 1000,
     "prev": {"five_hour": {"used_percentage": 2, "resets_at": 20000}},
     "new":  {"five_hour": {"used_percentage": 90, "resets_at": 2000}},
     "expect": {"five_hour": {"used_percentage": 2, "resets_at": 20000}}},
    {"name": "지난 창(resets_at <= now)은 폐기",
     "now": 3000,
     "prev": {"five_hour": {"used_percentage": 90, "resets_at": 2000}, "seven_day": {"used_percentage": 52, "resets_at": 5000}},
     "new":  {"five_hour": {"used_percentage": 80, "resets_at": 2500}},
     "expect": {"seven_day": {"used_percentage": 52, "resets_at": 5000}}},
    {"name": "전부 지났으면 비어 있음",
     "now": 9000,
     "prev": {"five_hour": {"used_percentage": 90, "resets_at": 2000}},
     "new":  {"seven_day": {"used_percentage": 80, "resets_at": 5000}},
     "expect": null},
    {"name": "처음 보고(prev 없음)는 그대로",
     "now": 1000,
     "prev": null,
     "new":  {"five_hour": {"used_percentage": 13, "resets_at": 2000}},
     "expect": {"five_hour": {"used_percentage": 13, "resets_at": 2000}}},
    {"name": "몇 초 어긋난 resets_at는 같은 창",
     "now": 1000,
     "prev": {"five_hour": {"used_percentage": 30, "resets_at": 2000.4}},
     "new":  {"five_hour": {"used_percentage": 25, "resets_at": 2000}},
     "expect": {"five_hour": {"used_percentage": 30, "resets_at": 2000.4}}},
    {"name": "객체가 아닌 값·알 수 없는 키 모양은 무시",
     "now": 1000,
     "prev": {"five_hour": 5, "extra": {"used_percentage": 1}},
     "new":  {"five_hour": null},
     "expect": {"extra": {"used_percentage": 1}}}
  ]
}
