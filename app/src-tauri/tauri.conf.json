{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Waitscape",
  "version": "0.5.2",
  "identifier": "io.github.jhkwim.waitscape",
  "build": {
    "frontendDist": "../../web",
    "beforeBuildCommand": "sh ../scripts/build_sidecar.sh",
    "beforeDevCommand": "sh ../scripts/build_sidecar.sh"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: wrmode: http://wrmode.localhost",
        "font-src": "'self' data:",
        "media-src": "'self' data: blob:",
        "connect-src": "ipc: http://ipc.localhost",
        "frame-src": "wrmode: http://wrmode.localhost",
        "child-src": "wrmode: http://wrmode.localhost",
        "worker-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "freezePrototype": false
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGNEVBNjdCMzgyNjJDNkIKUldSckxDWTRlNlpPTDNSWmdYK3FPdDFqU0E4dlRWcWtKVE5idHluSEdBQTNzRS9nelpod3F2THIK",
      "endpoints": [
        "https://github.com/jhkwim/waitscape/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Make the wait worth watching.",
    "longDescription": "Unofficial session dashboard for AI coding agents (Claude Code first).",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/wr-hook"
    ],
    "resources": [
      "THIRD_PARTY_LICENSES.html"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
