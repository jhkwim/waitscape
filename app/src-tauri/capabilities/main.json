{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "메인 창(앱 자체 문서 tauri://localhost)만. 외부 모드 iframe(wrmode:)·원격 URL에는 어떤 권한도 주지 않는다(remote 없음).",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-state",
    "allow-get-trace",
    "allow-get-daylog",
    "allow-daylog-seen",
    "allow-save-image",
    "allow-get-settings",
    "allow-set-settings",
    "allow-get-brand",
    "allow-list-modes",
    "allow-notify",
    "allow-open-widget",
    "allow-close-widget",
    "allow-set-tray-modes",
    "allow-open-terminal",
    "allow-hooks-status",
    "allow-hooks-install",
    "allow-hooks-uninstall",
    "allow-mcp-status",
    "allow-mcp-plan",
    "allow-mcp-apply",
    "allow-usage-status",
    "allow-usage-keychain",
    "allow-pick-mode-source",
    "allow-prepare-mode-install",
    "allow-commit-mode-install",
    "allow-cancel-mode-install",
    "allow-delete-mode",
    "allow-open-modes-dir",
    "allow-open-log-dir",
    "allow-autostart-set",
    "allow-app-info",
    "allow-nunchi-status",
    "allow-nunchi-retry",
    "allow-context-menu",
    "allow-menu-action",
    "allow-return-mini",
    "allow-clear-return-mini",
    "allow-update-status",
